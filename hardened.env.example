# Hardened baseline for a Jira Data Center deployment behind an AI chatbot.
# Copy to .env and adjust. Values here are deliberately stricter than the
# defaults in .env.example; nothing in the code defaults was changed.

# --- Jira (Data Center, Personal Access Token via Bearer) ---
JIRA_URL=https://jira.example.corp
JIRA_PERSONAL_TOKEN=
JIRA_SSL_VERIFY=true

# --- Blast radius ---
READ_ONLY_MODE=true
# Only expose the tools the assistant needs (see docs for toolset names).
#ENABLED_TOOLS=jira_search,jira_get_issue,jira_get_project_issues
JIRA_PROJECTS_FILTER=
CONFLUENCE_SPACES_FILTER=

# --- SSRF guard: internal Jira hosts are non-global, so allowlist it ---
MCP_ALLOWED_URL_DOMAINS=jira.example.corp

# --- HTTP transport (run behind a reverse proxy) ---
TRANSPORT=streamable-http
HOST=127.0.0.1
PORT=8000
# Never fall back to the server-side credential for unauthenticated callers.
#ALLOW_GLOBAL_CRED_FALLBACK=false
